# MySQL 8.0 服务地址与端口；与 API 的 8000 端口不同。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# 应用专用数据库，先按 sql/00_create_database.sql 手工创建。
MYSQL_DATABASE=zhiqu_team
MYSQL_USER=root
# 填写应用数据库密码，包含 # 或空格时加双引号。不要提交 .env。
MYSQL_PASSWORD=
# 允许的前端来源，必须与浏览器实际地址匹配。
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173
SESSION_HOURS=168
DEMO_ENABLED=true
# 以下三项必须同时配置，否则不启用模型。只填到 API 根目录，程序追加 /chat/completions。
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=45

# QQ 邮箱注册验证码。先在 QQ 邮箱设置中开启 SMTP 并生成授权码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
# 此处填写 SMTP 授权码，不是 QQ 登录密码，不要提交 .env。
SMTP_PASSWORD=
# 通常与 SMTP_USERNAME 填同一个完整 QQ 邮箱地址。
SMTP_FROM=
SMTP_TIMEOUT=10
# 单独生成至少 32 字符的随机密钥；验证码 HMAC 使用它，所有服务实例应保持一致。
EMAIL_CODE_SECRET=
# 仅选择 Docker Compose 启动新的 MySQL 容器时额外填写。
# MYSQL_ROOT_PASSWORD=
